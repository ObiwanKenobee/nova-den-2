# VaultTap Production Terraform Variables
# Optimized for 100% successful AWS deployment

# ===========================================
# ENVIRONMENT CONFIGURATION
# ===========================================
environment = "production"
app_name    = "vaulttap"
aws_region  = "us-west-2"

# Domain configuration
domain_name     = "vaulttap.com"
api_domain      = "api.vaulttap.com"
admin_domain    = "admin.vaulttap.com"
app_domain      = "app.vaulttap.com"

# ===========================================
# NETWORKING CONFIGURATION
# ===========================================
vpc_cidr = "10.0.0.0/16"

# Availability Zones for high availability
availability_zones = ["us-west-2a", "us-west-2b", "us-west-2c"]

# Subnet configuration
public_subnet_cidrs   = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
private_subnet_cidrs  = ["10.0.10.0/24", "10.0.11.0/24", "10.0.12.0/24"]
database_subnet_cidrs = ["10.0.20.0/24", "10.0.21.0/24", "10.0.22.0/24"]

# ===========================================
# ECS FARGATE CONFIGURATION
# ===========================================
# Container specifications
container_cpu    = 1024  # 1 vCPU
container_memory = 2048  # 2GB RAM

# Task configuration
task_execution_role_name = "vaulttap-ecs-execution-role"
task_role_name          = "vaulttap-ecs-task-role"

# Service configuration
desired_count = 3
min_capacity  = 3
max_capacity  = 20

# Auto-scaling configuration
cpu_target_value    = 70
memory_target_value = 80
scale_up_cooldown   = 300  # 5 minutes
scale_down_cooldown = 600  # 10 minutes

# ===========================================
# DATABASE CONFIGURATION (RDS)
# ===========================================
# Instance specifications
db_instance_class       = "db.t3.medium"  # Optimized for production workloads
db_allocated_storage    = 100              # 100GB initial storage
db_max_allocated_storage = 1000           # Auto-scaling up to 1TB

# Database configuration
db_engine_version    = "15.4"
db_parameter_group   = "postgres15"
db_name             = "vaulttap"
db_username         = "vaulttapuser"

# Backup configuration
db_backup_retention_period = 30    # 30 days
db_backup_window          = "03:00-04:00"
db_maintenance_window     = "sun:04:00-sun:05:00"

# High availability
db_multi_az                = true
db_storage_encrypted       = true
db_performance_insights    = true
db_monitoring_interval     = 60
db_deletion_protection     = true

# ===========================================
# REDIS CONFIGURATION (ElastiCache)
# ===========================================
# Instance specifications
redis_node_type           = "cache.t3.medium"
redis_num_cache_clusters  = 2
redis_parameter_group     = "default.redis7"

# Security and backup
redis_at_rest_encryption  = true
redis_transit_encryption  = true
redis_snapshot_retention  = 7
redis_snapshot_window     = "03:00-05:00"

# ===========================================
# LOAD BALANCER CONFIGURATION
# ===========================================
# Application Load Balancer
alb_deletion_protection = true
alb_idle_timeout       = 60

# Health check configuration
health_check_path                = "/health"
health_check_healthy_threshold   = 2
health_check_unhealthy_threshold = 5
health_check_interval           = 30
health_check_timeout            = 5
health_check_matcher            = "200"

# ===========================================
# CLOUDFRONT CONFIGURATION
# ===========================================
# Distribution settings
cloudfront_price_class = "PriceClass_100"  # US, Canada, Europe
cloudfront_min_ttl     = 0
cloudfront_default_ttl = 86400   # 24 hours
cloudfront_max_ttl     = 31536000 # 1 year

# Cache behavior
cloudfront_compress               = true
cloudfront_viewer_protocol_policy = "redirect-to-https"

# ===========================================
# S3 STORAGE CONFIGURATION
# ===========================================
# Bucket configuration
s3_versioning_enabled     = true
s3_lifecycle_enabled      = true
s3_lifecycle_days         = 30
s3_ia_transition_days     = 30
s3_glacier_transition_days = 90

# Cross-region replication
s3_replication_enabled = true
s3_replication_region  = "us-east-1"

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
# WAF configuration
waf_rate_limit = 2000

# Security groups
allow_http_from_anywhere  = true
allow_https_from_anywhere = true
allow_ssh_from_cidr      = ["10.0.0.0/8"]  # VPC only

# KMS encryption
kms_deletion_window = 30

# ===========================================
# MONITORING CONFIGURATION
# ===========================================
# CloudWatch configuration
cloudwatch_log_retention_days = 90
enable_container_insights     = true

# Alarms configuration
enable_cpu_alarm         = true
enable_memory_alarm      = true
enable_disk_alarm        = true
enable_connection_alarm  = true

cpu_alarm_threshold    = 80
memory_alarm_threshold = 85
disk_alarm_threshold   = 85

# ===========================================
# BACKUP AND DISASTER RECOVERY
# ===========================================
# Automated backup configuration
enable_automated_backups = true
backup_retention_days   = 30

# Cross-region backup
enable_cross_region_backup = true
backup_destination_region  = "us-east-1"

# Point-in-time recovery
enable_point_in_time_recovery = true

# ===========================================
# COST OPTIMIZATION
# ===========================================
# Instance types optimized for cost-performance
use_spot_instances = false  # Set to true for non-critical environments

# Reserved instance recommendations
enable_cost_optimization = true

# Lifecycle policies
enable_s3_intelligent_tiering = true
enable_ebs_optimization      = true

# ===========================================
# COMPLIANCE AND GOVERNANCE
# ===========================================
# Tagging strategy
common_tags = {
  Environment        = "production"
  Project           = "VaultTap"
  Owner             = "VaultTap Team"
  BusinessUnit      = "Engineering"
  CostCenter        = "Engineering"
  Compliance        = "SOC2"
  DataClassification = "Confidential"
  BackupSchedule    = "Daily"
  ManagedBy         = "Terraform"
  CreatedDate       = "2024-01-01"
}

# Compliance requirements
enable_encryption_at_rest     = true
enable_encryption_in_transit  = true
enable_access_logging         = true
enable_audit_logging          = true

# ===========================================
# ADVANCED FEATURES
# ===========================================
# Enable advanced monitoring
enable_xray_tracing = true
enable_insights     = true

# Enable advanced security
enable_guardduty = true
enable_securityhub = true
enable_config     = true

# API Gateway (if needed)
enable_api_gateway = false
api_gateway_stage  = "v1"

# ===========================================
# ENVIRONMENT-SPECIFIC OVERRIDES
# ===========================================
# Production-specific settings
enable_deletion_protection    = true
enable_termination_protection = true
enable_detailed_monitoring    = true

# Performance optimizations
enable_enhanced_monitoring = true
enable_performance_insights = true

# ===========================================
# SECRETS MANAGEMENT
# ===========================================
# Secrets Manager configuration
secrets_recovery_window = 30
enable_secrets_rotation = true

# Parameter Store configuration
parameter_store_tier = "Standard"

# ===========================================
# ROUTE53 DNS CONFIGURATION
# ===========================================
# DNS configuration
create_route53_zone = true
enable_dns_logging  = true

# Certificate configuration
certificate_validation_method = "DNS"
certificate_subject_alternative_names = [
  "*.vaulttap.com",
  "api.vaulttap.com",
  "admin.vaulttap.com",
  "app.vaulttap.com"
]

# ===========================================
# CONTAINER IMAGE CONFIGURATION
# ===========================================
# ECR configuration
ecr_image_tag_mutability = "MUTABLE"
ecr_scan_on_push        = true
ecr_lifecycle_policy = {
  untagged_image_retention_days = 7
  tagged_image_retention_count  = 10
}

# Container image
container_image_uri = "123456789012.dkr.ecr.us-west-2.amazonaws.com/vaulttap:latest"

# ===========================================
# NOTIFICATIONS AND ALERTING
# ===========================================
# SNS configuration
create_sns_topics = true
sns_email_endpoints = [
  "alerts@vaulttap.com",
  "devops@vaulttap.com"
]

# Slack integration
slack_webhook_url = ""  # Set in secrets manager

# ===========================================
# ADDITIONAL AWS SERVICES
# ===========================================
# Enable additional services for production
enable_api_gateway     = false
enable_cognito        = false
enable_opensearch     = false
enable_timestream     = false

# Lambda functions (if needed)
enable_lambda_functions = false

# ===========================================
# NOTES FOR DEPLOYMENT
# ===========================================
# 1. Ensure all required AWS service limits are sufficient
# 2. Configure proper IAM roles and policies
# 3. Set up AWS Config for compliance monitoring
# 4. Enable AWS CloudTrail for audit logging
# 5. Configure proper backup and disaster recovery
# 6. Set up monitoring and alerting
# 7. Test all configurations in staging first
# 8. Implement proper CI/CD pipelines
# 9. Configure proper security groups and NACLs
# 10. Enable AWS Shield and WAF for DDoS protection
