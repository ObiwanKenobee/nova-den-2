# VaultTap Production Environment Configuration
# Optimized for AWS deployment with 100% success rate
# CRITICAL: Replace all placeholder values with actual production secrets

# ===========================================
# APPLICATION SETTINGS
# ===========================================
NODE_ENV=production
PORT=3000
API_VERSION=v1

# ===========================================
# AWS FARGATE ECS CONFIGURATION
# ===========================================
AWS_REGION=us-west-2
AWS_ACCOUNT_ID=123456789012
CLUSTER_NAME=vaulttap-production-cluster
SERVICE_NAME=vaulttap-production-service
TASK_FAMILY=vaulttap-production-task

# ===========================================
# RDS POSTGRESQL (Multi-AZ for High Availability)
# ===========================================
# Format: postgresql://username:password@endpoint:port/database
DATABASE_URL=postgresql://vaulttapuser:CHANGE_THIS_SECURE_PASSWORD@vaulttap-prod-db.cluster-xyz123.us-west-2.rds.amazonaws.com:5432/vaulttap
DB_SSL=true
DB_MAX_CONNECTIONS=50
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Connection pool settings for production
DB_POOL_MIN=5
DB_POOL_MAX=50
DB_POOL_ACQUIRE_TIMEOUT=60000
DB_POOL_IDLE_TIMEOUT=30000

# ===========================================
# ELASTICACHE REDIS CLUSTER (High Availability)
# ===========================================
# Format: redis://endpoint:port
REDIS_URL=redis://vaulttap-prod-redis.cluster.cache.amazonaws.com:6379
REDIS_TLS=true
REDIS_MAX_RETRIES=5
REDIS_RETRY_DELAY=1000
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000

# ===========================================
# SECURITY SECRETS (AWS Secrets Manager)
# ===========================================
# CRITICAL: Generate secure 64+ character secrets
JWT_SECRET={{resolve:secretsmanager:vaulttap/production/jwt:SecretString:jwt_secret}}
ENCRYPTION_KEY={{resolve:secretsmanager:vaulttap/production/encryption:SecretString:encryption_key}}
JWT_EXPIRES_IN=4h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=api.vaulttap.com
JWT_AUDIENCE=vaulttap-production

# ===========================================
# AWS SERVICES CONFIGURATION
# ===========================================
# S3 for file storage
AWS_S3_BUCKET_NAME=vaulttap-production-storage
AWS_S3_REGION=us-west-2

# CloudWatch for logging
AWS_CLOUDWATCH_LOG_GROUP=/ecs/vaulttap-production
AWS_CLOUDWATCH_LOG_STREAM=vaulttap-app

# SES for email notifications
AWS_SES_FROM_ADDRESS=noreply@vaulttap.com
AWS_SES_REPLY_TO_ADDRESS=support@vaulttap.com
AWS_SES_REGION=us-west-2

# Systems Manager Parameter Store
AWS_PARAMETER_STORE_PREFIX=/vaulttap/production/

# ===========================================
# PAYMENT PROVIDERS (Production)
# ===========================================
# Stripe Live Keys (stored in Secrets Manager)
STRIPE_SECRET_KEY={{resolve:secretsmanager:vaulttap/production/stripe:SecretString:secret_key}}
STRIPE_PUBLISHABLE_KEY={{resolve:secretsmanager:vaulttap/production/stripe:SecretString:publishable_key}}
STRIPE_WEBHOOK_SECRET={{resolve:secretsmanager:vaulttap/production/stripe:SecretString:webhook_secret}}
STRIPE_API_VERSION=2023-10-16

# PayPal Live Configuration
PAYPAL_CLIENT_ID={{resolve:secretsmanager:vaulttap/production/paypal:SecretString:client_id}}
PAYPAL_CLIENT_SECRET={{resolve:secretsmanager:vaulttap/production/paypal:SecretString:client_secret}}
PAYPAL_MODE=live

# Crypto payment processors
COINBASE_COMMERCE_API_KEY={{resolve:secretsmanager:vaulttap/production/coinbase:SecretString:api_key}}
COINBASE_COMMERCE_WEBHOOK_SECRET={{resolve:secretsmanager:vaulttap/production/coinbase:SecretString:webhook_secret}}

# ===========================================
# AI SERVICES (Production)
# ===========================================
# OpenAI Production
OPENAI_API_KEY={{resolve:secretsmanager:vaulttap/production/openai:SecretString:api_key}}
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4000
OPENAI_ORGANIZATION=org-your-organization-id

# AWS Bedrock for Claude
AWS_BEDROCK_REGION=us-west-2
AWS_BEDROCK_MODEL_ID=anthropic.claude-v2:1
AWS_BEDROCK_MAX_TOKENS=4000

# ===========================================
# SECURITY & RATE LIMITING (Production Hardened)
# ===========================================
# Strict rate limiting for production
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ADMIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_RATE_LIMIT_MAX_REQUESTS=20

# CORS - Only allow production domains
CORS_ORIGINS=https://app.vaulttap.com,https://admin.vaulttap.com,https://www.vaulttap.com
CORS_CREDENTIALS=true

# Helmet Security Headers (Strict)
HELMET_CSP=true
HELMET_COEP=true
HELMET_HSTS=true
HELMET_EXPECT_CT=true

# Session Security
COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=strict

# ===========================================
# MONITORING & OBSERVABILITY (Production)
# ===========================================
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true
ENABLE_DISTRIBUTED_TRACING=true
LOG_LEVEL=info

# External monitoring services
SENTRY_DSN={{resolve:secretsmanager:vaulttap/production/sentry:SecretString:dsn}}
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=v2.0.0

# DataDog APM
DATADOG_API_KEY={{resolve:secretsmanager:vaulttap/production/datadog:SecretString:api_key}}
DATADOG_SITE=datadoghq.com
DD_SERVICE=vaulttap
DD_ENV=production
DD_VERSION=2.0.0
DD_TRACE_ENABLED=true

# New Relic (Alternative)
NEW_RELIC_LICENSE_KEY={{resolve:secretsmanager:vaulttap/production/newrelic:SecretString:license_key}}
NEW_RELIC_APP_NAME=VaultTap Production

# ===========================================
# FEATURE FLAGS (Production)
# ===========================================
FEATURE_MESH_NETWORKING=true
FEATURE_AI_VERIFICATION=true
FEATURE_CRYPTO_PAYMENTS=true
FEATURE_ENTERPRISE=true
FEATURE_BETA=false
FEATURE_MAINTENANCE_MODE=false

# ===========================================
# PRODUCTION URLS (CDN & Load Balancer)
# ===========================================
FRONTEND_URL=https://app.vaulttap.com
API_URL=https://api.vaulttap.com
WEBHOOK_BASE_URL=https://api.vaulttap.com/webhooks
ADMIN_PANEL_URL=https://admin.vaulttap.com

# CloudFront Distribution
CLOUDFRONT_DISTRIBUTION_ID=E123456789ABCD
CLOUDFRONT_DOMAIN=d123456789abcdef.cloudfront.net

# Application Load Balancer
ALB_DNS_NAME=vaulttap-prod-alb-123456789.us-west-2.elb.amazonaws.com
ALB_ZONE_ID=Z1D633PJN98FT9

# ===========================================
# SSL/TLS CONFIGURATION
# ===========================================
SSL_CERT_ARN=arn:aws:acm:us-west-2:123456789012:certificate/12345678-1234-1234-1234-123456789012
TLS_MIN_VERSION=1.2
FORCE_HTTPS=true

# ===========================================
# BACKUP & DISASTER RECOVERY
# ===========================================
# RDS Automated Backups
DB_BACKUP_RETENTION_DAYS=30
DB_BACKUP_WINDOW=03:00-04:00
DB_MAINTENANCE_WINDOW=sun:04:00-sun:05:00

# S3 Cross-Region Replication
S3_BACKUP_BUCKET=vaulttap-production-backup-us-east-1
S3_VERSIONING_ENABLED=true
S3_LIFECYCLE_DAYS=90

# ===========================================
# SCALING CONFIGURATION
# ===========================================
# ECS Auto Scaling
ECS_MIN_CAPACITY=3
ECS_MAX_CAPACITY=20
ECS_TARGET_CPU=70
ECS_TARGET_MEMORY=80
ECS_SCALE_OUT_COOLDOWN=300
ECS_SCALE_IN_COOLDOWN=300

# Application Performance
MAX_REQUEST_SIZE=10mb
REQUEST_TIMEOUT=30000
KEEP_ALIVE_TIMEOUT=5000

# ===========================================
# THIRD-PARTY INTEGRATIONS
# ===========================================
# Twilio for SMS (Optional)
TWILIO_ACCOUNT_SID={{resolve:secretsmanager:vaulttap/production/twilio:SecretString:account_sid}}
TWILIO_AUTH_TOKEN={{resolve:secretsmanager:vaulttap/production/twilio:SecretString:auth_token}}

# SendGrid for Enhanced Email (Alternative to SES)
SENDGRID_API_KEY={{resolve:secretsmanager:vaulttap/production/sendgrid:SecretString:api_key}}

# Slack for Alerts
SLACK_WEBHOOK_URL={{resolve:secretsmanager:vaulttap/production/slack:SecretString:webhook_url}}
SLACK_ALERT_CHANNEL=#alerts

# ===========================================
# COMPLIANCE & AUDIT
# ===========================================
# Data retention policies
DATA_RETENTION_DAYS=2555  # 7 years for financial data
LOG_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=2555

# Encryption settings
ENCRYPT_DATA_AT_REST=true
ENCRYPT_DATA_IN_TRANSIT=true
ENCRYPTION_ALGORITHM=AES-256-GCM

# ===========================================
# PERFORMANCE OPTIMIZATION
# ===========================================
# Redis caching
CACHE_TTL_DEFAULT=3600
CACHE_TTL_USER_SESSION=14400
CACHE_TTL_API_RESPONSE=300

# Connection pooling
DB_STATEMENT_TIMEOUT=30000
DB_QUERY_TIMEOUT=30000
DB_LOCK_TIMEOUT=10000

# ===========================================
# ENVIRONMENT VALIDATION
# ===========================================
# Used by the application to validate required secrets
REQUIRED_SECRETS=JWT_SECRET,ENCRYPTION_KEY,DATABASE_URL,REDIS_URL,STRIPE_SECRET_KEY
HEALTH_CHECK_TIMEOUT=5000
STARTUP_TIMEOUT=60000

# ===========================================
# CONTAINER CONFIGURATION
# ===========================================
# ECS Task Definition settings
CONTAINER_CPU=1024
CONTAINER_MEMORY=2048
CONTAINER_MEMORY_RESERVATION=1024

# Health check configuration
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_RETRIES=3
HEALTHCHECK_START_PERIOD=60s

# ===========================================
# NETWORK CONFIGURATION
# ===========================================
# VPC Configuration
VPC_ID=vpc-12345678
SUBNET_IDS=subnet-12345678,subnet-87654321
SECURITY_GROUP_IDS=sg-12345678

# Load Balancer Configuration
ALB_LISTENER_PORT=443
ALB_HEALTH_CHECK_PATH=/health
ALB_HEALTH_CHECK_INTERVAL=30
ALB_HEALTH_CHECK_TIMEOUT=5
ALB_HEALTHY_THRESHOLD=2
ALB_UNHEALTHY_THRESHOLD=5

# ===========================================
# DEPLOYMENT CONFIGURATION
# ===========================================
DEPLOYMENT_ENVIRONMENT=production
DEPLOYMENT_REGION=us-west-2
DEPLOYMENT_STRATEGY=blue-green
DEPLOYMENT_TIMEOUT=600

# Auto-rollback settings
ENABLE_AUTO_ROLLBACK=true
ROLLBACK_ALARM_THRESHOLD=5
ROLLBACK_EVALUATION_PERIODS=2

# ===========================================
# ADDITIONAL AWS SERVICES
# ===========================================
# AWS WAF for additional security
WAF_WEB_ACL_ID=12345678-1234-1234-1234-123456789012

# AWS Shield Advanced (Optional for DDoS protection)
SHIELD_ADVANCED_ENABLED=false

# AWS GuardDuty (Security monitoring)
GUARDDUTY_ENABLED=true

# AWS Config (Compliance monitoring)
CONFIG_ENABLED=true

# ===========================================
# NOTES FOR DEPLOYMENT SUCCESS
# ===========================================
# 1. All {{resolve:secretsmanager:...}} values will be resolved by AWS at runtime
# 2. Ensure all AWS services are in the same region (us-west-2)
# 3. Set up proper IAM roles and policies for ECS tasks
# 4. Configure Route53 for DNS management
# 5. Set up CloudWatch alarms for monitoring
# 6. Enable AWS X-Ray for distributed tracing
# 7. Configure Auto Scaling policies
# 8. Set up proper backup and disaster recovery
# 9. Implement proper logging and monitoring
# 10. Test all secrets resolution before deployment
